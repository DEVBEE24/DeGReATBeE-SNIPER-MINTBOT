# Database Connection (PostgreSQL - used by the bot for all data persistence)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Private Key for the Execution Wallet (keep this safe!)
PRIVATE_KEY=0xYourWalletPrivateKeyHere

# RPC Endpoints (Use dedicated private providers or high-speed endpoints)
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR-KEY
BASE_RPC_URL=https://mainnet.base.org
ROBINHOOD_RPC_URL=https://rpc.robinhoodchain.com
INK_RPC_URL=https://rpc-qnd.inkonchain.com
ARC_RPC_URL=https://rpc.mainnet.arc.io

# Telegram Control Bot Token (for remote monitoring/manual control)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# AES-256-GCM Encryption Master Key (for wallet private key encryption at rest)
# Generate with: openssl rand -hex 32
ENCRYPTION_MASTER_KEY=your-32-byte-hex-encryption-master-key-here
