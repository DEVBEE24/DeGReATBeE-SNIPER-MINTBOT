datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String         @id @default(uuid())
  telegramId   String         @unique
  username     String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  wallets      Wallet[]
  settings     UserSettings?
  whaleTargets WhaleTarget[]
  chains       ChainToggle[]
}

model UserSettings {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  priorityGwei      String   @default("3.0")
  maxEthCap         String   @default("0.05") // Max ETH safety cap per transaction
  defaultGasLimit   String   @default("0.005")
  slippageTolerance Int      @default(1)
  autoMintActive    Boolean  @default(false)
}

model Wallet {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  address        String
  encryptedKey   String
  label          String   @default("Sniper Wallet")
  isDefault      Boolean  @default(false)
  isActive       Boolean  @default(true) // Individual wallet active/inactive toggle
  createdAt      DateTime @default(now())
}

model WhaleTarget {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chainName   String
  address     String
  label       String   @default("Whale Target")
  createdAt   DateTime @default(now())
}

model ChainToggle {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chainName String   // base, ethereum, robinhood, ink, arc
  enabled   Boolean  @default(true)
  @@unique([userId, chainName])
}
